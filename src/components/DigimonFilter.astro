---
/**
 * Digivice Radar — búsqueda por nombre y filtros de servidor.
 * Los ids son el contrato con el script de `src/pages/dex/index.astro`:
 * - `#dex-search` (input)
 * - `#dex-level` (select, valor = nivel nativo Digi-API)
 * - `#dex-attribute` (select)
 * - `#dex-xantibody` (select: "", "true", "false")
 * - `#dex-clear` (button)
 */
import { t, normalizeLang, localizeLevel, localizeAttr } from '../i18n/index.js';

interface LevelOption {
  value: string;
  label: string;
}
interface Props {
  levels?: LevelOption[];
  attributes?: string[];
  lang?: string;
}
const { levels = [], attributes = [], lang: langProp = 'es' } = Astro.props;
const lang = normalizeLang(langProp);
---
<section class="filter-card">
  <div class="filter-title">
    <span class="material-icons filter-icon">radar</span>
    <span data-i18n="filter.title">{t(lang, 'filter.title')}</span>
  </div>

  <div class="filter-group">
    <label class="filter-label" for="dex-search" data-i18n="filter.searchLabel">{t(lang, 'filter.searchLabel')}</label>
    <div class="input-wrap">
      <span class="material-icons input-icon">search</span>
      <input
        id="dex-search"
        type="search"
        placeholder={t(lang, 'filter.searchPh')}
        data-i18n-ph="filter.searchPh"
        autocomplete="off"
        data-test="dex-search"
      />
    </div>
  </div>

  <div class="filter-group">
    <label class="filter-label" for="dex-level" data-i18n="filter.levelLabel">{t(lang, 'filter.levelLabel')}</label>
    <div class="input-wrap">
      <span class="material-icons input-icon">signal_cellular_alt</span>
      <select id="dex-level" data-level-options>
        <option value="" data-i18n-opt="filter.allLevels">{t(lang, 'filter.allLevels')}</option>
        {levels.map((l) => <option value={l.value}>{localizeLevel(l.value, lang)}</option>)}
      </select>
    </div>
  </div>

  <div class="filter-group">
    <label class="filter-label" for="dex-attribute" data-i18n="filter.attrLabel">{t(lang, 'filter.attrLabel')}</label>
    <div class="input-wrap">
      <span class="material-icons input-icon">category</span>
      <select id="dex-attribute" data-attr-options>
        <option value="" data-i18n-opt="filter.allAttr">{t(lang, 'filter.allAttr')}</option>
        {attributes.map((a) => <option value={a}>{localizeAttr(a, lang)}</option>)}
      </select>
    </div>
  </div>

  <div class="filter-group">
    <label class="filter-label" for="dex-xantibody" data-i18n="filter.xLabel">{t(lang, 'filter.xLabel')}</label>
    <div class="input-wrap">
      <span class="material-icons input-icon">science</span>
      <select id="dex-xantibody">
        <option value="" data-i18n-opt="filter.allX">{t(lang, 'filter.allX')}</option>
        <option value="true" data-i18n-opt="filter.carriers">{t(lang, 'filter.carriers')}</option>
        <option value="false" data-i18n-opt="filter.noX">{t(lang, 'filter.noX')}</option>
      </select>
    </div>
  </div>

  <button class="btn btn-outline filter-reset" id="dex-clear" type="button">
    <span class="material-icons">backspace</span> <span data-i18n="filter.clear">{t(lang, 'filter.clear')}</span>
  </button>
</section>

<style>
  .filter-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .filter-title {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #fff;
    margin-bottom: 16px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
  }

  .filter-icon {
    margin-right: 6px;
    color: var(--secondary);
  }

  .filter-group + .filter-group {
    margin-top: 16px;
  }

  .filter-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .input-wrap {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--secondary);
    font-size: 20px;
    pointer-events: none;
  }

  .input-wrap input,
  .input-wrap select {
    width: 100%;
    background: #212121;
    border: 1px solid transparent;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 4px 4px 0 0;
    color: #fff;
    padding: 10px 10px 10px 38px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
  }

  .input-wrap input:focus,
  .input-wrap select:focus {
    border-bottom-color: var(--secondary);
  }

  .filter-reset {
    width: 100%;
    margin-top: 16px;
    padding: 10px 16px;
    font-size: 13px;
  }
</style>
