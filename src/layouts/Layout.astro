---
import '../styles/global.css';
import { t, normalizeLang } from '../i18n/index.js';
import { getSeriesByGroup, seriesHref, SERIES_GROUPS } from '../data/series/index.js';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: string;
}

const {
  title = 'DigiDex Web',
  description = 'DigiDex Web — Enciclopedia interactiva para explorar Digimon, consultar sus características, niveles e información detallada.',
  canonical: canonicalProp = '',
  lang: langProp = 'es',
} = Astro.props;
const lang = normalizeLang(langProp);
const currentPath = Astro.url.pathname;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absCanonical = canonicalProp
  ? canonicalProp.startsWith('http')
    ? canonicalProp
    : `${site}${canonicalProp}`
  : '';
const canonical = absCanonical || (site ? `${site}${currentPath}` : currentPath);
const genGroups = SERIES_GROUPS.map((g) => ({
  ...g,
  label: t(lang, `generations.group${g.id === 'classics' ? 'Classics' : g.id === 'new-eras' ? 'NewEras' : 'Recent'}`),
  items: getSeriesByGroup(g.id),
}));
const genActive = currentPath.startsWith('/generaciones');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f1f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="header-inner">
        <a href="/" class="brand" aria-label="Ir al inicio">
          <span class="material-icons brand-icon">pets</span>
          <span class="brand-title"><span class="brand-digi">Digi</span>Dex <span class="brand-web">Web</span></span>
          <span class="brand-caption" data-i18n="header.caption">{t(lang, 'header.caption')}</span>
        </a>
        <div class="header-links">
          <a href="/dex" class:list={['header-link', { active: currentPath.startsWith('/dex') }]}>
            <span class="material-icons">radar</span> <span class="header-link-text" data-i18n="header.dex">{t(lang, 'header.dex')}</span>
          </a>
          <div class="gen-nav" data-gen-nav>
            <button
              type="button"
              class:list={['header-link', 'gen-toggle', { active: genActive }]}
              data-gen-toggle
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="gen-menu"
              aria-label={t(lang, 'nav.generationsLabel')}
            >
              <span class="material-icons">movie</span>
              <span class="header-link-text gen-label" data-i18n="nav.generations">{t(lang, 'nav.generations')}</span>
              <span class="material-icons gen-chevron" aria-hidden="true">expand_more</span>
            </button>
            <div class="gen-menu" id="gen-menu" data-gen-menu hidden>
              <div class="gen-menu-head">
                <div>
                  <div class="gen-menu-title" data-i18n="generations.menuTitle">{t(lang, 'generations.menuTitle')}</div>
                  <div class="gen-menu-desc" data-i18n="generations.menuDesc">{t(lang, 'generations.menuDesc')}</div>
                </div>
                <a class="gen-view-all" href="/generaciones">
                  <span data-i18n="generations.viewAll">{t(lang, 'generations.viewAll')}</span>
                  <span class="material-icons" aria-hidden="true">arrow_forward</span>
                </a>
              </div>
              <div class="gen-groups">
                {genGroups.map((g) => (
                  <section class="gen-group" aria-label={g.label}>
                    <h3 class="gen-group-title">{g.label}</h3>
                    <ul class="gen-list">
                      {g.items.map((s) => (
                        <li>
                          <a
                            class="gen-item"
                            href={seriesHref(s.slug)}
                            aria-current={currentPath === seriesHref(s.slug) ? 'page' : undefined}
                          >
                            <span class="gen-accent" style={`background:${s.accent}`} aria-hidden="true"></span>
                            <span class="material-icons gen-item-icon" aria-hidden="true">{s.icon}</span>
                            <span class="gen-item-text">
                              <span class="gen-item-name">{s.name}</span>
                              <span class="gen-item-period">{lang === 'en' && s.periodEn ? s.periodEn : s.period}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </div>
          </div>
          <div class="lang-select" data-lang-select>
            <button
              type="button"
              class="lang-toggle"
              data-lang-toggle
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label={t(lang, 'header.langLabel')}
            >
              <span class="material-icons lang-globe" aria-hidden="true">language</span>
              <span class="lang-label-full" data-lang-label>{lang === 'en' ? 'English' : 'Español'}</span>
              <span class="lang-label-short" data-lang-label-short>{lang === 'en' ? 'EN' : 'ES'}</span>
              <span class="material-icons lang-chevron" aria-hidden="true">expand_more</span>
            </button>
            <div class="lang-menu" role="menu" data-lang-menu hidden>
              <button
                type="button"
                class="lang-option"
                role="menuitemradio"
                aria-checked={lang === 'es' ? 'true' : 'false'}
                data-lang-option="es"
              >
                <span class="lang-option-text">Español</span>
                <span class="material-icons lang-check" aria-hidden="true">check</span>
              </button>
              <button
                type="button"
                class="lang-option"
                role="menuitemradio"
                aria-checked={lang === 'en' ? 'true' : 'false'}
                data-lang-option="en"
              >
                <span class="lang-option-text">English</span>
                <span class="material-icons lang-check" aria-hidden="true">check</span>
              </button>
            </div>
          </div>
          <a
            href="https://digimon.net/"
            target="_blank"
            rel="noopener"
            class="official-btn"
            title={t(lang, 'header.official')}
            aria-label={t(lang, 'header.official')}
            data-i18n-aria="header.official"
          >
            <img
              src="/official-logo.png"
              alt="Digimon Web — sitio oficial"
              class="official-logo"
              width="38"
              height="38"
            />
          </a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <span data-i18n="footer.fan">{t(lang, 'footer.fan')}</span>
        <span class="footer-sep">·</span>
        <span><span data-i18n="footer.data">{t(lang, 'footer.data')}</span>: digi-api.com</span>
      </div>
    </footer>
    <script>
      import { getStoredLang, setLanguage, initLanguage } from '../i18n/index.js';

      // Arranque existente: aplica el idioma guardado al DOM estático y avisa
      // a las páginas (evento `digidex:lang` para re-render dinámico).
      initLanguage();

      const LANG_NAMES = { es: 'Español', en: 'English' };
      const LANG_SHORT = { es: 'ES', en: 'EN' };

      const select = document.querySelector('[data-lang-select]');
      const toggle = select?.querySelector('[data-lang-toggle]');
      const menu = select?.querySelector('[data-lang-menu]');
      const options = [...(select?.querySelectorAll('[data-lang-option]') ?? [])];

      function paint(lang) {
        const label = select?.querySelector('[data-lang-label]');
        const short = select?.querySelector('[data-lang-label-short]');
        if (label) label.textContent = LANG_NAMES[lang] ?? LANG_NAMES.es;
        if (short) short.textContent = LANG_SHORT[lang] ?? LANG_SHORT.es;
        options.forEach((opt) => {
          const active = opt.getAttribute('data-lang-option') === lang;
          opt.classList.toggle('active', active);
          opt.setAttribute('aria-checked', active ? 'true' : 'false');
        });
      }

      function setOpen(open) {
        if (!toggle || !menu) return;
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.classList.toggle('open', open);
      }

      function isOpen() {
        return !!menu && !menu.hidden;
      }

      toggle?.addEventListener('click', () => setOpen(!isOpen()));

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          setLanguage(opt.getAttribute('data-lang-option'));
          paint(opt.getAttribute('data-lang-option'));
          setOpen(false);
          toggle?.focus();
        });
      });

      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && select && !select.contains(e.target)) setOpen(false);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          setOpen(false);
          toggle?.focus();
        }
      });

      select?.addEventListener('keydown', (e) => {
        if (!isOpen() || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) return;
        e.preventDefault();
        const idx = options.indexOf(document.activeElement);
        const next = e.key === 'ArrowDown'
          ? options[(idx + 1) % options.length]
          : options[(idx - 1 + options.length) % options.length];
        next?.focus();
      });

      select?.addEventListener('focusout', (e) => {
        if (isOpen() && select && !select.contains(e.relatedTarget)) setOpen(false);
      });

      paint(getStoredLang());

      // Mega menú Generaciones: clic/teclado, sin hover obligatorio.
      const genNav = document.querySelector('[data-gen-nav]');
      const genToggle = genNav?.querySelector('[data-gen-toggle]');
      const genMenu = genNav?.querySelector('[data-gen-menu]');
      const genLinks = [...(genNav?.querySelectorAll('.gen-item, .gen-view-all') ?? [])];

      function setGenOpen(open) {
        if (!genToggle || !genMenu) return;
        genMenu.hidden = !open;
        genToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        genToggle.classList.toggle('open', open);
      }

      function isGenOpen() {
        return !!genMenu && !genMenu.hidden;
      }

      genToggle?.addEventListener('click', () => setGenOpen(!isGenOpen()));

      document.addEventListener('pointerdown', (e) => {
        if (isGenOpen() && genNav && !genNav.contains(e.target)) setGenOpen(false);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isGenOpen()) {
          setGenOpen(false);
          genToggle?.focus();
        }
      });

      genNav?.addEventListener('keydown', (e) => {
        if (!isGenOpen() || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) return;
        e.preventDefault();
        const idx = genLinks.indexOf(document.activeElement);
        const next = e.key === 'ArrowDown'
          ? genLinks[(idx + 1) % genLinks.length]
          : genLinks[(idx - 1 + genLinks.length) % genLinks.length];
        next?.focus();
      });

      genNav?.addEventListener('focusout', (e) => {
        if (isGenOpen() && genNav && !genNav.contains(e.relatedTarget)) setGenOpen(false);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(21, 27, 46, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 18px rgba(15, 98, 254, 0.22);
  }

  .header-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    border-radius: 8px;
  }

  .brand-icon {
    color: var(--secondary);
  }

  .brand-title {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .brand-digi {
    color: var(--secondary);
  }

  .brand-web {
    color: var(--accent);
  }

  .brand-caption {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.55);
    margin-left: 8px;
  }

  @media (max-width: 640px) {
    .brand-caption {
      display: none;
    }
  }

  .header-links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .lang-select {
    position: relative;
    margin: 0 6px;
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .lang-toggle:hover {
    border-color: rgba(255, 204, 0, 0.6);
    background: rgba(255, 255, 255, 0.08);
  }

  .lang-toggle:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 2px;
    border-color: var(--secondary);
    box-shadow: 0 0 12px rgba(255, 204, 0, 0.25);
  }

  .lang-toggle.open {
    border-color: var(--secondary);
  }

  .lang-globe {
    font-size: 17px;
    color: var(--secondary);
  }

  .lang-label-short {
    display: none;
  }

  .lang-chevron {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    transition: transform 0.2s ease;
  }

  .lang-toggle.open .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 168px;
    padding: 6px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(21, 27, 46, 0.98);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    z-index: 100;
  }

  .lang-menu[hidden] {
    display: none;
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .lang-option:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .lang-option:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: -2px;
  }

  .lang-option.active {
    background: rgba(255, 204, 0, 0.1);
    color: var(--secondary);
    font-weight: 800;
  }

  .lang-check {
    font-size: 18px;
    opacity: 0;
  }

  .lang-option.active .lang-check {
    opacity: 1;
    color: var(--secondary);
  }

  @media (max-width: 640px) {
    .lang-select {
      margin: 0 2px;
    }

    .lang-toggle {
      padding: 7px 9px;
    }

    .lang-label-full {
      display: none;
    }

    .lang-label-short {
      display: inline;
    }
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  .header-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .header-link.active {
    color: var(--secondary);
  }

  .gen-nav {
    position: relative;
  }

  .gen-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .gen-toggle:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 2px;
  }

  .gen-chevron {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    transition: transform 0.2s ease;
  }

  .gen-toggle.open .gen-chevron {
    transform: rotate(180deg);
  }

  .gen-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(720px, calc(100vw - 24px));
    max-height: min(70vh, 560px);
    overflow-y: auto;
    padding: 18px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(13, 18, 36, 0.98);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    z-index: 100;
  }

  .gen-menu[hidden] {
    display: none;
  }

  .gen-menu-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .gen-menu-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--secondary);
  }

  .gen-menu-desc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 2px;
  }

  .gen-view-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: var(--secondary);
    text-decoration: none;
    padding: 6px 4px;
    border-radius: 6px;
  }

  .gen-view-all:hover {
    text-decoration: underline;
  }

  .gen-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .gen-group-title {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .gen-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gen-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .gen-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .gen-item:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: -2px;
  }

  .gen-item[aria-current="page"] {
    border-color: rgba(255, 204, 0, 0.5);
    background: rgba(255, 204, 0, 0.07);
  }

  .gen-accent {
    width: 4px;
    align-self: stretch;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .gen-item-icon {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.65);
    flex-shrink: 0;
  }

  .gen-item-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .gen-item-name {
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gen-item-period {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 900px) {
    .gen-groups {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .gen-groups {
      grid-template-columns: 1fr;
    }

    .gen-menu {
      position: fixed;
      top: 60px;
      left: 12px;
      right: 12px;
      width: auto;
    }

    .header-link-text,
    .gen-label {
      display: none;
    }

    .header-link,
    .gen-toggle {
      padding: 8px 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gen-chevron {
      transition: none;
    }
  }

  .official-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #fff;
    text-decoration: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .official-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .official-btn:hover {
    border-color: var(--secondary);
    color: var(--secondary);
    box-shadow: 0 0 14px rgba(255, 204, 0, 0.35);
    transform: translateY(-1px);
  }

  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(11, 15, 31, 0.9);
  }

  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 14px 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-sep {
    opacity: 0.5;
  }
</style>
