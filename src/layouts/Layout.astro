---
import '../styles/global.css';
import { t, normalizeLang } from '../i18n/index.js';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: string;
}

const {
  title = 'DigiDex Web',
  description = 'DigiDex Web — Enciclopedia interactiva para explorar Digimon, consultar sus características, niveles e información detallada.',
  canonical: canonicalProp = '',
  lang: langProp = 'es',
} = Astro.props;
const lang = normalizeLang(langProp);
const currentPath = Astro.url.pathname;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = canonicalProp || (site ? `${site}${currentPath}` : currentPath);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f1f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="header-inner">
        <a href="/" class="brand" aria-label="Ir al inicio">
          <span class="material-icons brand-icon">pets</span>
          <span class="brand-title"><span class="brand-digi">Digi</span>Dex <span class="brand-web">Web</span></span>
          <span class="brand-caption" data-i18n="header.caption">{t(lang, 'header.caption')}</span>
        </a>
        <div class="header-links">
          <a href="/dex" class:list={['header-link', { active: currentPath.startsWith('/dex') }]}>
            <span class="material-icons">radar</span> <span data-i18n="header.dex">{t(lang, 'header.dex')}</span>
          </a>
          <div
            class="lang-switch"
            role="group"
            aria-label={t(lang, 'header.langLabel')}
            data-i18n-aria="header.langLabel"
          >
            <span class="material-icons lang-globe" aria-hidden="true">language</span>
            <button type="button" class="lang-btn" data-lang-btn="es" aria-pressed={lang === 'es' ? 'true' : 'false'}>ES</button>
            <span class="lang-sep" aria-hidden="true">|</span>
            <button type="button" class="lang-btn" data-lang-btn="en" aria-pressed={lang === 'en' ? 'true' : 'false'}>EN</button>
          </div>
          <a
            href="https://digimon.net/"
            target="_blank"
            rel="noopener"
            class="official-btn"
            title={t(lang, 'header.official')}
            aria-label={t(lang, 'header.official')}
            data-i18n-aria="header.official"
          >
            <img
              src="/official-logo.png"
              alt="Digimon Web — sitio oficial"
              class="official-logo"
              width="38"
              height="38"
            />
          </a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <span data-i18n="footer.fan">{t(lang, 'footer.fan')}</span>
        <span class="footer-sep">·</span>
        <span><span data-i18n="footer.data">{t(lang, 'footer.data')}</span>: digi-api.com</span>
      </div>
    </footer>
    <script>
      import { initLanguage } from '../i18n/index.js';
      initLanguage();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(21, 27, 46, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 18px rgba(15, 98, 254, 0.22);
  }

  .header-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    border-radius: 8px;
  }

  .brand-icon {
    color: var(--secondary);
  }

  .brand-title {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .brand-digi {
    color: var(--secondary);
  }

  .brand-web {
    color: var(--accent);
  }

  .brand-caption {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.55);
    margin-left: 8px;
  }

  @media (max-width: 640px) {
    .brand-caption {
      display: none;
    }
  }

  .header-links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin: 0 6px;
    padding: 4px 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
  }

  .lang-globe {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.55);
    margin-right: 2px;
  }

  .lang-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
    font-family: inherit;
  }

  .lang-btn:hover {
    color: #fff;
  }

  .lang-btn.active {
    color: var(--secondary);
  }

  .lang-sep {
    color: rgba(255, 255, 255, 0.3);
    font-size: 12px;
  }

  .header-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  .header-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .header-link.active {
    color: var(--secondary);
  }

  .official-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: #fff;
    text-decoration: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .official-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .official-btn:hover {
    border-color: var(--secondary);
    color: var(--secondary);
    box-shadow: 0 0 14px rgba(255, 204, 0, 0.35);
    transform: translateY(-1px);
  }

  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(11, 15, 31, 0.9);
  }

  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 14px 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-sep {
    opacity: 0.5;
  }
</style>
