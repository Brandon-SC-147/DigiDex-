---
import Layout from '../../layouts/Layout.astro';
import DigimonFilter from '../../components/DigimonFilter.astro';
import DigimonCard from '../../components/DigimonCard.astro';
import {
  getDigimonPage,
  LEVEL_DISPLAY,
  NATIVE_LEVELS,
  NATIVE_ATTRIBUTES,
} from '../../services/digimonService.js';

const PAGE_SIZE = 24;

let firstPage = { items: [], currentPage: 0, totalPages: 1, totalElements: 0 };
let buildError = false;
try {
  firstPage = await getDigimonPage({ page: 0, pageSize: PAGE_SIZE });
} catch {
  buildError = true;
}

const levelOptions = NATIVE_LEVELS.map((native) => ({
  value: native,
  label: LEVEL_DISPLAY[native] ?? native,
}));
---
<Layout
  title="Catálogo — DigiDex Web"
  description="Catálogo de Digimon: busca por nombre, filtra por nivel y atributo, y consulta la ficha completa con evoluciones y skills."
>
  <main class="dex-page-bg">
    <div class="container-xl">
      <div class="page-hero">
        <div class="hero-kicker">CATÁLOGO DIGITAL</div>
        <h1 class="hero-title">
          <span class="text-digimon-gradient">Explora</span> el Mundo Digital
        </h1>
        <p class="hero-desc">
          Consulta los Digimon del catálogo, filtra por nivel y atributo, y abre la ficha
          completa de cada criatura digital.
        </p>
      </div>

      <div class="dex-layout">
        <aside class="dex-sidebar">
          <div class="sticky">
            <DigimonFilter levels={levelOptions} attributes={NATIVE_ATTRIBUTES} />

            <section class="counter-card">
              <div class="counter-value" id="dex-count">{firstPage.totalElements}</div>
              <div class="counter-label">DIGIMONS ENCONTRADOS</div>
            </section>
          </div>
        </aside>

        <section class="dex-results" id="dex-results">
          <div class="results-toolbar">
            <span class="material-icons toolbar-icon">storage</span>
            <span class="results-title">Registros del Dex</span>
            <span class="results-meta" id="dex-meta"></span>
          </div>

          <div id="dex-error" class="error-card" hidden>
            <div class="state-block">
              <span class="material-icons state-icon error-icon">cloud_off</span>
              <div class="state-heading">No se pudo conectar con la API</div>
              <div class="state-sub">Revisa tu conexión o inténtalo de nuevo en unos segundos.</div>
              <button class="btn btn-outline" id="dex-retry" type="button">
                <span class="material-icons">refresh</span> Reintentar
              </button>
            </div>
          </div>

          <div id="dex-loading" class="dex-grid" hidden aria-live="polite"></div>

          <div id="dex-empty" class="empty-state" hidden>
            <span class="material-icons state-icon">search_off</span>
            <div class="state-heading">No se encontraron resultados</div>
            <div class="state-sub">Prueba con otro nombre o quita los filtros.</div>
          </div>

          <div id="dex-grid" class="dex-grid">
            {firstPage.items.map((d) => <DigimonCard digimon={d} />)}
          </div>

          <nav class="pagination" id="dex-pagination" aria-label="Paginación del Dex"></nav>
          <noscript>
            <p class="noscript-note">Activa JavaScript para filtrar y paginar el catálogo completo.</p>
          </noscript>
        </section>
      </div>
    </div>
  </main>

  <script type="application/json" id="dex-first-page" set:html={JSON.stringify(firstPage)}></script>
</Layout>

<script>
  import { getDigimonPage, getLevelClass } from '../../services/digimonService.js';

  const PAGE_SIZE = 24;

  const searchInput = document.getElementById('dex-search');
  const levelSelect = document.getElementById('dex-level');
  const attrSelect = document.getElementById('dex-attribute');
  const xantiSelect = document.getElementById('dex-xantibody');
  const clearBtn = document.getElementById('dex-clear');
  const grid = document.getElementById('dex-grid');
  const loadingEl = document.getElementById('dex-loading');
  const emptyEl = document.getElementById('dex-empty');
  const errorEl = document.getElementById('dex-error');
  const countEl = document.getElementById('dex-count');
  const metaEl = document.getElementById('dex-meta');
  const paginationEl = document.getElementById('dex-pagination');
  const retryBtn = document.getElementById('dex-retry');
  retryBtn?.addEventListener('click', () => loadPage());

  let firstPage = { items: [], currentPage: 0, totalPages: 1, totalElements: 0 };
  try {
    firstPage = JSON.parse(document.getElementById('dex-first-page')?.textContent || '{}');
  } catch { /* se recarga desde la API */ }

  // Estado desde la URL. `page` es base 1 para el usuario, base 0 para la API.
  const params = new URLSearchParams(location.search);
  if (searchInput && params.get('name')) searchInput.value = params.get('name');
  if (levelSelect && params.get('level')) levelSelect.value = params.get('level');
  if (attrSelect && params.get('attribute')) attrSelect.value = params.get('attribute');
  if (xantiSelect && params.get('xAntibody')) xantiSelect.value = params.get('xAntibody');
  let uiPage = Math.max(1, parseInt(params.get('page') || '1', 10) || 1);

  let debounce;
  let requestId = 0;

  function readFilters() {
    return {
      name: searchInput?.value.trim() || '',
      level: levelSelect?.value || '',
      attribute: attrSelect?.value || '',
      xAntibody: xantiSelect?.value || '',
    };
  }

  function hasActiveFilters() {
    const f = readFilters();
    return Boolean(f.name || f.level || f.attribute || f.xAntibody);
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function cardHtml(d) {
    const href = d.href || `/dex/${d.id}`;
    const attrs = (d.attributes || []).slice(0, 2).map((a) => `<span class="digi-attr">${escapeHtml(a)}</span>`).join('');
    return `
      <article class="digi-card hover-lift">
        <div class="img-container">
          <img src="${escapeHtml(d.img)}" alt="${escapeHtml(d.name)}" class="digi-img" loading="lazy" decoding="async" width="240" height="180" onerror="this.onerror=null;this.src='/favicon.svg'" />
          <div class="scan-line"></div>
        </div>
        <div class="digi-body">
          <div>
            <div class="digi-name">${escapeHtml(d.name)}</div>
            <div class="digi-meta">
              <span class="badge ${escapeHtml(getLevelClass(d.level))}">${escapeHtml(d.level || '')}</span>
              <span class="digi-kind">DIGIMON</span>
            </div>
            ${attrs ? `<div class="digi-attrs">${attrs}</div>` : ''}
          </div>
          <a href="${href}" class="btn-text digi-link">
            Ver ficha <span class="material-icons">arrow_forward</span>
          </a>
        </div>
      </article>`;
  }

  function skeletonHtml() {
    return Array.from({ length: 8 })
      .map(() => '<div class="digi-card skeleton-card" aria-hidden="true"><div class="img-container"></div><div class="digi-body"></div></div>')
      .join('');
  }

  function syncUrl() {
    const f = readFilters();
    const next = new URLSearchParams();
    if (f.name) next.set('name', f.name);
    if (f.level) next.set('level', f.level);
    if (f.attribute) next.set('attribute', f.attribute);
    if (f.xAntibody) next.set('xAntibody', f.xAntibody);
    if (uiPage > 1) next.set('page', String(uiPage));
    history.replaceState(null, '', next.size ? `?${next}` : location.pathname);
  }

  function pageWindow(current, total) {
    const size = 5;
    let start = Math.max(0, Math.min(current - 2, total - size));
    const end = Math.min(total, start + size);
    start = Math.max(0, end - size);
    const out = [];
    for (let i = start; i < end; i++) out.push(i);
    return out;
  }

  function renderPagination(totalPages) {
    if (!paginationEl) return;
    if (totalPages <= 1) {
      paginationEl.innerHTML = '';
      return;
    }
    const current = uiPage - 1;
    const nums = pageWindow(current, totalPages)
      .map((i) => `<button type="button" class="page-btn${i === current ? ' active' : ''}" data-page="${i + 1}" ${i === current ? 'aria-current="page"' : ''}>${i + 1}</button>`)
      .join('');
    paginationEl.innerHTML = `
      <button type="button" class="page-btn page-nav" data-page="${uiPage - 1}" ${uiPage <= 1 ? 'disabled' : ''} aria-label="Página anterior">
        <span class="material-icons">chevron_left</span>
      </button>
      ${nums}
      <button type="button" class="page-btn page-nav" data-page="${uiPage + 1}" ${uiPage >= totalPages ? 'disabled' : ''} aria-label="Página siguiente">
        <span class="material-icons">chevron_right</span>
      </button>`;
    paginationEl.querySelectorAll('[data-page]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = parseInt(btn.dataset.page, 10);
        if (!Number.isNaN(p) && p >= 1) {
          uiPage = p;
          loadPage();
          document.getElementById('dex-results')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  function render(data) {
    const totalPages = Math.max(1, data.totalPages || 1);
    if (uiPage > totalPages) uiPage = totalPages;
    if (countEl) countEl.textContent = String(data.totalElements ?? 0);
    if (metaEl) metaEl.textContent = (data.totalElements ?? 0) > 0
      ? `Página ${uiPage} de ${totalPages} · ${data.totalElements} resultados`
      : '';
    const hasResults = (data.items?.length ?? 0) > 0;
    if (emptyEl) emptyEl.hidden = hasResults || !errorEl.hidden;
    if (grid) {
      grid.hidden = !hasResults;
      grid.innerHTML = (data.items || []).map(cardHtml).join('');
    }
    renderPagination(totalPages);
    syncUrl();
  }

  async function loadPage() {
    const myRequest = ++requestId;
    if (errorEl) errorEl.hidden = true;
    if (emptyEl) emptyEl.hidden = true;
    if (grid) grid.hidden = true;
    if (loadingEl) {
      loadingEl.hidden = false;
      loadingEl.innerHTML = skeletonHtml();
    }
    try {
      const f = readFilters();
      const data = await getDigimonPage({
        page: uiPage - 1,
        pageSize: PAGE_SIZE,
        name: f.name,
        level: f.level,
        attribute: f.attribute,
        xAntibody: f.xAntibody,
      });
      if (myRequest !== requestId) return;
      if (loadingEl) loadingEl.hidden = true;
      render(data);
    } catch (err) {
      if (myRequest !== requestId) return;
      console.error('[DigiDex] Error cargando página:', err);
      if (loadingEl) loadingEl.hidden = true;
      if (errorEl) errorEl.hidden = false;
      if (emptyEl) emptyEl.hidden = true;
    }
  }

  searchInput?.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      uiPage = 1;
      loadPage();
    }, 350);
  });
  levelSelect?.addEventListener('change', () => { uiPage = 1; loadPage(); });
  attrSelect?.addEventListener('change', () => { uiPage = 1; loadPage(); });
  xantiSelect?.addEventListener('change', () => { uiPage = 1; loadPage(); });
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (levelSelect) levelSelect.value = '';
    if (attrSelect) attrSelect.value = '';
    if (xantiSelect) xantiSelect.value = '';
    uiPage = 1;
    loadPage();
  });

  // Hidratación: si la URL trae estado distinto al SSR, se carga desde la API.
  if (grid && (hasActiveFilters() || uiPage > 1)) {
    loadPage();
  } else if (grid) {
    render(firstPage);
  }
</script>

<style>
  .page-hero {
    padding-top: 8px;
    text-align: center;
    margin-bottom: 40px;
  }

  .hero-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--secondary);
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 900;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 10px 0 6px;
  }

  .hero-desc {
    max-width: 560px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.65);
    font-size: 15px;
    line-height: 1.6;
  }

  .dex-layout {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    padding-bottom: 48px;
  }

  @media (min-width: 900px) {
    .dex-layout {
      grid-template-columns: 280px 1fr;
    }
  }

  .sticky {
    position: sticky;
    top: 76px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .counter-card,
  .error-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .counter-card {
    padding: 18px;
    text-align: center;
  }

  .counter-value {
    font-size: 40px;
    font-weight: 900;
    color: var(--secondary);
    line-height: 1.1;
  }

  .counter-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 4px;
  }

  .results-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }

  .toolbar-icon {
    color: var(--secondary);
    font-size: 20px;
  }

  .results-title {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #fff;
    text-transform: uppercase;
  }

  .results-meta {
    margin-left: auto;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
  }

  .state-block {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 48px 24px;
    text-align: center;
    flex-direction: column;
  }

  .state-icon {
    font-size: 56px;
    color: #9e9e9e;
  }

  .error-icon {
    color: var(--negative);
  }

  .state-heading {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    margin-top: 12px;
  }

  .state-sub {
    color: rgba(255, 255, 255, 0.55);
    margin-top: 6px;
    margin-bottom: 20px;
  }

  .error-card {
    border-color: rgba(255, 82, 82, 0.4);
  }

  .empty-state {
    text-align: center;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    padding: 48px 24px;
  }

  .dex-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    justify-items: center;
  }

  .digi-attrs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }

  .digi-attr {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(45, 226, 230, 0.45);
    color: var(--info);
  }

  .skeleton-card {
    min-height: 280px;
    background: rgba(255, 255, 255, 0.04);
    animation: pulse 1.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }

  .page-btn {
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .page-btn:hover:not(:disabled) {
    border-color: var(--secondary);
    color: var(--secondary);
  }

  .page-btn.active {
    background: var(--secondary);
    border-color: var(--secondary);
    color: #3e2700;
  }

  .page-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .noscript-note {
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    margin-top: 16px;
  }
</style>
